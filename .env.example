# --- X (Twitter) API ---
# Bearer Token from your paid X API app (developer.x.com). Needs read access to
# the recent search endpoint (GET /2/tweets/search/recent).
X_BEARER_TOKEN=your_x_bearer_token_here

# --- Anthropic API ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model used to classify each tweet. Haiku is fast/cheap and plenty for this
# classification task; bump to a Sonnet model if you want deeper reasoning.
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5-20251001
# Max tokens Claude can use per tweet classification (higher = more room to
# reason through ambiguous/borderline tweets before answering).
ANTHROPIC_CLASSIFY_MAX_TOKENS=1024
# Model used to write the hourly report summary.
ANTHROPIC_REPORT_MODEL=claude-sonnet-5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat/channel/group ID that gets pinged for each "useful" tweet (complaints,
# genuine questions, advice, recommendations).
TELEGRAM_ALERT_CHAT_ID=your_group_or_channel_id_here
# Chat/channel/group ID that receives the periodic report.
# Defaults to TELEGRAM_ALERT_CHAT_ID if left blank.
TELEGRAM_REPORT_CHAT_ID=

# --- Monitoring targets ---
# Accounts to track mentions of (without the @)
X_TRACK_ACCOUNTS=bittimeexchange
# Keywords to track (case-insensitive, whole word match handled by X search)
X_TRACK_KEYWORDS=Bittime

# --- Timing (minutes) ---
SCRAPE_INTERVAL_MINUTES=5
REPORT_INTERVAL_MINUTES=60
# How far back the very first scrape looks (before any watermark exists).
# Keeps a cold start from pulling X's full 7-day recent-search history.
INITIAL_LOOKBACK_MINUTES=10

# --- Misc ---
# SQLite DB file location
DB_PATH=data/tweets.db
# Where generated report markdown files are saved
REPORTS_DIR=reports
# Set to "1" to also print debug logs
DEBUG=0
